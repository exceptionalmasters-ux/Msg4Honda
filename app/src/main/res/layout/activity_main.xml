<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/status_off"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/message_sources"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/whatsAppToggle"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/source_toggle_background"
                android:button="@null"
                android:drawableTop="@drawable/ic_whatsapp"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/whatsapp"
                android:textColor="@color/source_toggle_text"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/messengerToggle"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/source_toggle_background"
                android:button="@null"
                android:drawableTop="@drawable/ic_messenger"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/messenger"
                android:textColor="@color/source_toggle_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/smsToggle"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/source_toggle_background"
                android:button="@null"
                android:drawableTop="@drawable/ic_sms"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/sms_rcs"
                android:textColor="@color/source_toggle_text"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/mapsToggle"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/source_toggle_background"
                android:button="@null"
                android:drawableTop="@drawable/ic_maps"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/maps"
                android:textColor="@color/source_toggle_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/startStopButton"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/start_button"
        android:text="@string/start"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/mapsDebugButton"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/show_maps_debug"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/permissionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/permission_hint"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/privacy_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
</LinearLayout>
